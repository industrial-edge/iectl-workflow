# ─────────────────────────────────────────────────────────────────────────────
# .env — Configuration for iectl-workflow scripts
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables marked "Optional" can be left empty.
# Variables marked with a script name are only used by that script.
# ─────────────────────────────────────────────────────────────────────────────

# ─── IEM Configuration ───────────────────────────────────────────────────────
# Used by: create-ied.sh, standalone-app.sh, deploy-app.sh
IEM_USER="<iem-username>"           # Email address of the IEM user
IEM_PASSWORD="<iem-password>"       # Password of the IEM user
IEM_URL="<iem-url>"                 # IEM URL (e.g. https://iem.example.com)

# ─── Device Configuration ────────────────────────────────────────────────────
# Used by: create-ied.sh, activate-ied.sh
DEVICE_USER="<ied-email>"           # Email address / username of the device user
DEVICE_PASSWORD="<ied-password>"    # Password of the device user

# Used by: create-ied.sh, standalone-app.sh, deploy-app.sh
DEVICE_NAME="<ied-name>"            # Name of your Edge device

# Used by: activate-ied.sh
DEVICE_URL="<ied-url>"              # Edge device URL, https://[ip] (before onboarding)

# Used by: create-ied.sh
DEVICE_MAC="<ied-mac-address>"      # Edge device MAC address
DEVICE_TYPE="core.ieipc"            # Edge device type ID (use the correct type for your device)
DEVICE_LABEL=""                     # Optional: Label to assign to the device
DEVICE_DNS_PRIMARY=""               # Optional: Primary DNS server (overwrites DHCP if set)
DEVICE_DNS_SECONDARY=""             # Optional: Secondary DNS server (overwrites DHCP if set)

# ─── Standalone Application Configuration ────────────────────────────────────
# Used by: standalone-app.sh
APP_NAME="<application-name>"       # Application name
APP_REPO="<application-repo>"       # Application repository name (must be unique)

# ─── Application Deployment Configuration ────────────────────────────────────
# Used by: deploy-app.sh
APP_ID="<application-id>"           # Application ID as in IEM

# ─── IECTL Settings ──────────────────────────────────────────────────────────
IE_SKIP_CERTIFICATE=true            # Skip certificate verification (trusted environments only!)
EDGE_SKIP_TLS=1                     # Disable TLS verification
